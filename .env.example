# Скопировать в .env на VPS и заполнить. Файл .env в репозиторий не попадает.
#   cp .env.example .env && chmod 600 .env

# Образ из GHCR. Замените владельца на свой аккаунт или организацию.
BOT_IMAGE=ghcr.io/OWNER/cockrealsizebot:latest

# Токен от @BotFather.
Bot__Token=

# Соль для детерминированного хэша: длинная случайная строка, минимум 16 символов.
# Сменить её = переписать результаты всем сразу. Задаётся один раз.
#   openssl rand -base64 32
Bot__Salt=

# Часовой пояс, по границе суток которого сбрасывается замер.
Bot__TimeZone=Europe/Moscow
